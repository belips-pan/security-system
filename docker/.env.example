# Copy to .env and fill in real values. .env is gitignored - do not commit it.
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-20
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
FLOWER_PASSWORD=changeme-generate-with-openssl-rand-hex-16
REDIS_PASSWORD=changeme-generate-with-openssl-rand-hex-20
# edge_gateway's MQTT credential (mosquitto broker)
MOSQUITTO_PASSWORD=changeme-generate-with-openssl-rand-hex-16
# Shared by all five agent-type MQTT users (camera_agent, drone_agent,
# iot_agent, plc_agent, robot_agent) - see docker/mosquitto.acl
MOSQUITTO_AGENT_PASSWORD=changeme-generate-with-openssl-rand-hex-16
# monsys's shared "monsys" MQTT user (see docker/mosquitto.acl) - must match
# MQTT_PASSWORD in monsys/.env exactly.
MOSQUITTO_MONSYS_PASSWORD=changeme-generate-with-openssl-rand-hex-16
# Optional: initial admin password. If unset, app.py generates a random
# one at first startup and prints it once to the backend container logs.
#ADMIN_INITIAL_PASSWORD=
# Shared with monsys, a separate deployment on another VM: its
# SCANNER_API_KEY/BACKEND_API_KEY/SCANNER_BACKEND_API_KEY (monsys/.env) must
# be set to this exact same value, so the container_scanner agent's identity
# is provisioned transparently instead of copy-pasting a generated key out
# of backend startup logs into another host's .env by hand.
CONTAINER_SCANNER_API_KEY=changeme-generate-with-openssl-rand-hex-32
