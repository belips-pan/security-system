{
  "agent_id": "raspberrypi-01",
  "agent_type": "iot_agent",
  "version": "1.1",
  "_api_key_note": "Placeholder only. Real deployments must provision a unique, randomly generated API key per device and inject it as a secret, not commit it here.",
  "api_key": "CHANGE_ME_GENERATE_PER_DEVICE",
  "mqtt_username": "iot_agent",
  "mqtt_password": "CHANGE_ME",
  "config_timestamp": "2025-09-01T10:00:00Z",
  "metrics": {
    "system_metrics": {
      "collect": true,
      "frequency_seconds": 30,
      "parameters": {
        "cpu_threshold_percent": 85,
        "memory_threshold_mb": 512
      }
    },
    "network_connections": {
      "collect": true,
      "frequency_seconds": 60,
      "parameters": {
        "allowed_destinations": ["192.168.1.10", "192.168.1.20", "127.0.0.1"],
        "blocked_ports": [22, 23]
      }
    },
    "process_list": {
      "collect": true,
      "frequency_seconds": 120,
      "parameters": {
        "allowed_processes": ["python", "sshd", "systemd", "pi-app", "mosquitto"]
      }
    }
  }
}

